project_id           = "your-gcp-project-id"
region               = "us-central1"

# LLM (litellm) — the model-string prefix selects the provider.
# Examples: OpenAI (gpt-4o / gpt-4o-mini), Anthropic (claude-3-5-sonnet-20241022),
# Google Gemini (gemini/gemini-2.0-flash).
llm_model_fast       = "gpt-4o-mini"
llm_model_smart      = "gpt-4o"
# Set llm_api_key_env_name to the env var litellm expects for your provider:
# OPENAI_API_KEY, ANTHROPIC_API_KEY, or GEMINI_API_KEY.
llm_api_key_env_name = "OPENAI_API_KEY"
llm_api_key          = ""
serpapi_key          = ""
# Generate with: `applybot setup-auth` (prints the secret + otpauth URI).
# Enter the same secret in your authenticator app AND here.
dashboard_totp_secret = ""
image_tag            = "latest"
