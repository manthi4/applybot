# Dashboard TOTP code
DASHBOARD_TOTP_SECRET=...

GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json
GCP_PROJECT_ID=applybot-prod

# LLM (litellm — provider is chosen by the model string prefix).
# Set the API key env var for whichever provider you use, e.g. OPENAI_API_KEY,
# ANTHROPIC_API_KEY, or GEMINI_API_KEY. Locally the env var is the source of
# truth; in GCP the llm module reads keys live from Secret Manager instead.
LLM_MODEL_DEFAULT=gpt-4o-mini
LLM_MAX_RETRIES=3
OPENAI_API_KEY=...

# Job scraping
SERPAPI_KEY=...

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///data/applybot.db
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/applybot

# Cloud Functions (dashboard triggers these over HTTP)
DISCOVERY_FUNCTION_URL=...
APPLICATION_PREPARER_FUNCTION_URL=...
